---
import BuiltOn from "../components/landing/BuiltOn.astro";
import Closing from "../components/landing/Closing.astro";
import CodeSample from "../components/landing/CodeSample.astro";
import Enforcement from "../components/landing/Enforcement.astro";
import Hero from "../components/landing/Hero.astro";
import Layers from "../components/landing/Layers.astro";
import Tooling from "../components/landing/Tooling.astro";
import Landing from "../layouts/Landing.astro";

const repoUrl = process.env.BULL_REPO_URL;
---

<Landing
  title="Bull · The React framework that enforces MVVM"
  description="Bull is an opinionated React framework that refuses to build unless your code respects Model–View–ViewModel, and explains every violation. Built on Vite and React."
>
  <Hero />
  <main>
    <Layers />
    <Enforcement />
    <BuiltOn />
    <Tooling />
    <CodeSample />
  </main>
  <Closing repoUrl={repoUrl} />
</Landing>
