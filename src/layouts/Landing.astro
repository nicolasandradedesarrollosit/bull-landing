---
/**
 * The landing inside Starlight's own page: the same header, search, client router and theme as the
 * docs, so the navbar never changes and moving between them never reloads. The `splash` template
 * drops the sidebar; `hero` drops Starlight's title panel (the Hero override renders nothing).
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import "../styles/landing.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title: "Bull",
    description,
    template: "splash",
    hero: { title: "Bull" },
    pagefind: false,
    prev: false,
    next: false,
    editUrl: false,
    lastUpdated: false,
    head: [{ tag: "title", content: title }],
  }}
>
  <div class="landing not-content">
    <slot />
  </div>
</StarlightPage>

<script>
  // Copy-to-clipboard for the install commands. Module scripts run once with the client router, so
  // the buttons are wired on every page load, including when the landing is swapped back in.
  document.addEventListener("astro:page-load", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(".landing [data-copy]")) {
      button.addEventListener("click", async () => {
        const label = button.querySelector("[data-copied]");
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          if (label) label.textContent = "Copied";
        } catch {
          if (label) label.textContent = "Select and copy";
        }
        setTimeout(() => label && (label.textContent = "Copy"), 1600);
      });
    }
  });
</script>
