---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const commands = [
  {
    cmd: "bull g feature cart",
    doc: "generate",
    what: "Writes a repository, a ViewModel that receives it, its test and a bound View, and registers them in main.tsx.",
  },
  {
    cmd: "bull fix --dry-run",
    doc: "fix",
    what: "Shows a diff for the fixes with one right answer: renames, private state behind read-only views, type re-exports.",
  },
  {
    cmd: "bull graph --format html",
    doc: "graph",
    what: "Draws every import between layers. Edges that break the direction are red; Mermaid and DOT too.",
  },
  {
    cmd: "bull doctor",
    doc: "doctor",
    what: "Checks Node, React, a single copy of React, the config, tsconfig and ESLint, with a hint for each problem.",
  },
  {
    cmd: "bull info",
    doc: "info",
    what: "Lists each ViewModel’s public state, computeds and commands, what it injects and which Views bind it.",
  },
];
---

<section class="tooling">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Tooling</p>
        <h2 class="poster">Strict, not<br />stranded.</h2>
      </div>
      <p>
        A strict architecture needs help to follow. The CLI scaffolds code in the right place, fixes
        what it safely can and shows you the shape of your app.
      </p>
    </div>

    <ul class="commands">
      {
        commands.map((c) => (
          <li>
            <a href={`${base}/docs/cli/${c.doc}/`}>
              <code>
                <span class="prompt">$</span> {c.cmd}
              </code>
              <span class="what">{c.what}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tooling {
    background: var(--ink);
    color: var(--paper);
    --ink-soft: rgba(252, 251, 255, 0.68);
    --line: rgba(252, 251, 255, 0.16);
  }

  @media (prefers-color-scheme: dark) {
    .tooling {
      background: #0d0815;
      color: #f3eefa;
    }
  }

  .commands {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .commands li {
    border-top: 1px solid var(--line);
  }

  .commands li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .commands a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) auto;
    gap: 24px;
    align-items: center;
    padding: 24px 4px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .commands a:hover {
    background: rgba(252, 251, 255, 0.05);
  }

  code {
    font-size: clamp(15px, 1.6vw, 19px);
    font-weight: 600;
    color: var(--albero);
  }

  .prompt {
    color: rgba(252, 251, 255, 0.4);
  }

  .what {
    color: var(--ink-soft);
  }

  .arrow {
    font-size: 22px;
    transition: transform 0.15s ease;
  }

  .commands a:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .commands a {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .arrow {
      display: none;
    }
  }
</style>
