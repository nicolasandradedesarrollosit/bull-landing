---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const install = "npm create @bull@latest my-app";

// A real `bull build` run, replayed line by line. `t` is the line's role (for color).
type Line = { t: "cmd" | "dim" | "head" | "msg" | "code" | "caret" | "text" | "fix" | "fail" | "blank"; s: string };
const command = "npx bull build";
const lines: Line[] = [
  { t: "cmd", s: command },
  { t: "blank", s: "" },
  { t: "dim", s: "  ♉︎ bull v0.3.0  · build" },
  { t: "blank", s: "" },
  { t: "head", s: "── VIEW IMPORTS MODEL ── src/view/cart.view.tsx:3:1  MVVM100" },
  { t: "blank", s: "" },
  { t: "msg", s: "  The View imports CartRepository directly from the Model." },
  { t: "blank", s: "" },
  { t: "code", s: '  3 │ import { CartRepository } from "../model/cart.repository";' },
  { t: "caret", s: "    │ ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^" },
  { t: "blank", s: "" },
  { t: "text", s: "  The View only knows its ViewModel. If it talks to the Model" },
  { t: "text", s: "  directly, presentation logic gets tied to the UI." },
  { t: "blank", s: "" },
  { t: "fix", s: "  How to fix:" },
  { t: "text", s: "    1. Move the use of CartRepository to CartViewModel." },
  { t: "text", s: "    2. Expose the data as state and the actions as commands." },
  { t: "blank", s: "" },
  { t: "fail", s: "  ✗ Build cancelled: 1 MVVM architecture violation." },
];
// The font size is fitted so the widest line fills the terminal: it never scrolls sideways.
const columns = Math.max(...lines.map((line) => line.s.length + (line.t === "cmd" ? 2 : 0))) + 1;

const esc = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// Built as one string: whitespace between the line spans would render inside <pre>.
const screen = lines
  .map((line, i) => {
    const content =
      line.t === "cmd"
        ? `<span class="prompt">$ </span><span class="typed">${esc(line.s)}</span>`
        : esc(line.s) || " ";
    return `<span class="l ${line.t}" style="--i:${i}">${content}</span>`;
  })
  .join("");
---

<header class="hero">
  <div class="wrap stage">
    <div class="pitch">
      <p class="eyebrow">React framework · MVVM enforced</p>
      <h1 class="poster">It won’t<br /><span class="accent">build.</span></h1>
      <p class="lede">
        Bull is an opinionated React framework that enforces Model–View–ViewModel. Import the Model
        from a View, keep state in a component or touch the DOM from a ViewModel, and the build stops
        with the reason and the fix. Vite still does the bundling.
      </p>
      <div class="actions">
        <a class="button primary" href={`${base}/docs/getting-started/`}>Get started</a>
        <button class="copy" type="button" data-copy={install}>
          {install} <span data-copied>Copy</span>
        </button>
      </div>
    </div>

    <figure class="terminal" aria-label="A bull build that stops on an MVVM violation">
      <div class="bar">
        <span></span><span></span><span></span>
        <button type="button" class="replay" aria-label="Replay the build">Replay</button>
      </div>
      <pre class="screen" style={`--cols:${columns};--chars:${command.length}`} data-playing><code set:html={screen} /></pre>
    </figure>
  </div>
</header>

<script>
  // Module scripts run once with the client router: wire the button on every page load.
  document.addEventListener("astro:page-load", () => {
    const screen = document.querySelector<HTMLElement>(".terminal .screen");
    document.querySelector(".terminal .replay")?.addEventListener("click", () => {
      if (!screen) return;
      screen.removeAttribute("data-playing");
      void screen.offsetWidth; // restart the CSS animations
      screen.setAttribute("data-playing", "");
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(var(--space-8), 8vw, var(--space-9));
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(55% 60% at 85% 10%, rgba(139, 114, 255, 0.2), transparent 70%),
      radial-gradient(45% 55% at 0% 100%, rgba(231, 178, 74, 0.13), transparent 70%),
      var(--paper);
  }

  /* Raked sand: faint arcs, like the lines a rake leaves in the bullring. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-radial-gradient(circle at 15% 120%, transparent 0 22px, rgba(231, 178, 74, 0.05) 22px 23px);
    mask-image: linear-gradient(to top, #000, transparent 75%);
    pointer-events: none;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
    padding-top: clamp(var(--space-7), 7vw, var(--space-9));
  }

  h1 {
    font-size: clamp(84px, 10.5vw, 156px);
  }

  h1 .accent {
    color: var(--albero);
  }

  .lede {
    font-size: 19px;
    max-width: 44ch;
    color: var(--ink-soft);
    margin: var(--space-5) 0 var(--space-6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .terminal {
    margin: 0;
    background: var(--terminal);
    border-radius: 18px;
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px var(--line-strong),
      0 0 80px -20px rgba(139, 114, 255, 0.35);
    overflow: hidden;
    transform: rotate(-1.2deg);
    container-type: inline-size;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--line);
  }

  .bar > span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }

  .replay {
    margin-left: auto;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    font: 600 12px var(--body);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .replay:hover {
    color: #fff;
    border-color: var(--ink-soft);
    background: rgba(255, 255, 255, 0.06);
  }

  .screen {
    --pad: clamp(14px, 4cqi, 24px);
    margin: 0;
    white-space: normal; /* the lines are blocks: ignore the whitespace between them */
    padding: var(--pad);
    /* JetBrains Mono advances 0.6em per character: fit `--cols` characters in the width. */
    font-size: clamp(6.5px, calc((100cqi - 2 * var(--pad)) / (var(--cols) * 0.6)), 13px);
    line-height: 1.6;
    color: #d9d2e6;
    overflow: hidden;
  }

  .screen :global(.l) {
    display: block;
    white-space: pre;
  }

  .screen :global(.prompt) {
    color: var(--albero);
  }

  .screen :global(.dim) {
    color: var(--ink-faint);
    /* Draw the Taurus glyph from a text symbol font, not the emoji font. */
    font-family: var(--mono), "Segoe UI Symbol", "Noto Sans Symbols 2", "Apple Symbols", monospace;
  }

  .screen :global(.head) {
    color: var(--rose);
    font-weight: 700;
  }

  .screen :global(.msg) {
    color: #fff;
    font-weight: 700;
  }

  .screen :global(.code) {
    color: var(--ink);
  }

  .screen :global(.caret) {
    color: var(--rose);
  }

  .screen :global(.text) {
    color: var(--ink-soft);
  }

  .screen :global(.fix) {
    color: var(--view);
    font-weight: 700;
  }

  .screen :global(.fail) {
    color: var(--rose);
    font-weight: 700;
  }

  /* Replay: the command types itself, then the output appears line by line. */
  [data-playing] :global(.l) {
    animation: appear 0.01s both;
    animation-delay: calc(1.2s + var(--i) * 0.11s);
  }

  [data-playing] :global(.l.cmd) {
    animation: none;
  }

  [data-playing] :global(.typed) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    animation: type 0.9s steps(var(--chars)) 0.2s both;
  }

  @keyframes appear {
    from {
      visibility: hidden;
    }
  }

  @keyframes type {
    from {
      width: 0;
    }
    to {
      width: calc(var(--chars) * 1ch);
    }
  }

  @media (max-width: 900px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
    }
    .terminal {
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .copy {
      font-size: 13px;
    }
  }
</style>
