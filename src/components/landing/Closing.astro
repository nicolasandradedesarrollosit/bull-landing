---
import BullMark from "./BullMark.astro";

interface Props {
  repoUrl?: string;
}

const { repoUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="closing">
  <div class="wrap inner">
    <BullMark size={96} />
    <h2 class="poster">Stubborn about<br />architecture.</h2>
    <p>Start with a project that already passes every rule, then try to break one.</p>
    <div class="actions">
      <button class="copy" type="button" data-copy="npm create @bull-js@latest my-app">
        npm create @bull-js@latest my-app <span data-copied>Copy</span>
      </button>
      <a class="button primary" href={`${base}/docs/introduction/`}>Read the docs</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap row">
    <span>Bull · MIT license</span>
    <nav aria-label="Footer">
      <a href={`${base}/docs/getting-started/`}>Getting started</a>
      <a href={`${base}/docs/run-locally/`}>Run locally</a>
      <a href={`${base}/docs/rules/`}>Rules</a>
      {repoUrl && <a href={repoUrl}>GitHub</a>}
    </nav>
  </div>
</footer>

<style>
  .closing {
    text-align: center;
    border-top: 1px solid var(--line);
    background: radial-gradient(50% 70% at 50% 100%, rgba(231, 178, 74, 0.16), transparent 70%), var(--paper);
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  h2 {
    font-size: clamp(56px, 9vw, 120px);
  }

  p {
    margin: 0;
    font-size: 19px;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .footer {
    padding-block: var(--space-6);
    font-size: 14px;
    color: var(--ink-faint);
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .row {
    align-items: center;
  }

  .row nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .row nav a {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .row nav a:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.06);
  }
</style>
