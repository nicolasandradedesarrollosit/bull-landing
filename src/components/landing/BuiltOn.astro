---
// Logos from the CC0 "logos" set (gilbarbara/logos, via Iconify), inlined as SVG components.
import KnockoutLogo from "../../assets/logos/knockout.svg";
import ReactLogo from "../../assets/logos/react.svg";
import ViteLogo from "../../assets/logos/vite.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pillars = [
  {
    name: "Vite",
    Logo: ViteLogo,
    wordmark: false,
    role: "The bundler",
    color: "#bd34fe",
    text: "The dev server, hot reload and the production build are Vite. Bull checks the architecture first and adds the dev overlay as a Vite plugin. Anything Vite can do goes under vite in bull.config.ts.",
    sample: "bull build → check → vite build",
    href: "/docs/configuration/",
  },
  {
    name: "React",
    Logo: ReactLogo,
    wordmark: false,
    role: "The View",
    color: "#00d8ff",
    text: "Views are plain React function components. useBinding subscribes them to a ViewModel through useSyncExternalStore, so they re-render only when what they read changes. React 18 and 19 both work.",
    sample: "useBinding(vm.total)",
    href: "/docs/runtime/react/",
  },
  {
    name: "Knockout",
    Logo: KnockoutLogo,
    wordmark: true,
    role: "The idea",
    color: "#e42e16",
    text: "Knockout.js brought MVVM to the browser with observables, computeds and declarative bindings. Bull keeps that model, typed and testable, without bindings in the HTML: the View is React, the ViewModel a class.",
    sample: "ko.observable → this.state",
    href: "/docs/runtime/reactivity/",
  },
];
---

<section class="built-on">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Built on</p>
        <h2 class="poster">Not a bundler.<br />A backbone.</h2>
      </div>
      <p>
        Bull does not replace your bundler or your UI library. It is the architecture layer on top of
        them, with an idea borrowed from Knockout.
      </p>
    </div>

    <div class="pillars">
      {
        pillars.map((p) => (
          <a class="pillar" href={`${base}${p.href}`} style={`--accent:${p.color}`}>
            <span class:list={["logo", { wordmark: p.wordmark }]}>
              <p.Logo aria-hidden="true" />
            </span>
            <span class="role">{p.role}</span>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
            <code>{p.sample}</code>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    overflow: clip;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  /* A glow of the pillar's color in the corner. */
  .pillar::before {
    content: "";
    position: absolute;
    inset: -40% -40% auto auto;
    width: 220px;
    height: 220px;
    background: radial-gradient(closest-side, var(--accent), transparent);
    opacity: 0.12;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .pillar:hover {
    transform: translateY(-3px);
    background: var(--card-hover);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .pillar:hover::before {
    opacity: 0.24;
  }

  .logo {
    display: flex;
    align-items: center;
    height: 44px;
    margin-bottom: var(--space-2);
  }

  .logo :global(svg) {
    height: 40px;
    width: auto;
    transition: transform 0.2s ease;
  }

  /* Knockout's logo is a wordmark: shorter, so it reads at the same weight as the icons. */
  .logo.wordmark :global(svg) {
    height: 26px;
  }

  .pillar:hover .logo :global(svg) {
    transform: scale(1.06);
  }

  .role {
    font: 600 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font: 800 48px/0.95 var(--display);
    text-transform: uppercase;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    flex: 1;
  }

  code {
    align-self: flex-start;
    max-width: 100%;
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
